# LLM 설정
LLM_PROVIDER=ollama              # ollama | anthropic
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=llama3.2
ROADMAP_MODEL=llama3.2

# 임베딩 설정
EMBEDDING_PROVIDER=huggingface   # huggingface | ollama
EMBEDDING_MODEL=jhgan/ko-sroberta-multitask

# Anthropic (LLM_PROVIDER=anthropic 사용 시)
ANTHROPIC_API_KEY=
