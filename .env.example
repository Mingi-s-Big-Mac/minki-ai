# LLM 설정
LLM_PROVIDER=bedrock             # bedrock | ollama | anthropic
OLLAMA_BASE_URL=http://localhost:11434
# eu-central-1 은 Claude 계열이 추론 프로필(eu. 접두사)만 지원합니다.
CHAT_MODEL=eu.anthropic.claude-haiku-4-5-20251001-v1:0
ROADMAP_MODEL=eu.anthropic.claude-sonnet-4-5-20250929-v1:0
# 응답 최대 출력 토큰 (답변이 잘리면 늘리세요)
MAX_TOKENS=8192

# 임베딩 설정
EMBEDDING_PROVIDER=bedrock       # bedrock | huggingface | ollama
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# Amazon Bedrock (LLM_PROVIDER=bedrock 또는 EMBEDDING_PROVIDER=bedrock 사용 시)
# 아래 키를 비워두면 boto3 기본 자격 증명 체인(EC2 IAM 역할, ~/.aws 등)을 사용합니다.
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Anthropic (LLM_PROVIDER=anthropic 사용 시)
ANTHROPIC_API_KEY=

# API 인증 키 (설정 시 /api/* 호출에 X-API-Key 헤더 필요). 비우면 인증 없음.
API_KEY=
